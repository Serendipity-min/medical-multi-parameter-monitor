{
  "sntp-policy": {
    "command": [
      "gcc",
      "-std=c11",
      "-Wall",
      "-Wextra",
      "-Werror",
      "-Igateway/mqtt/src",
      "gateway/physical_can/tests/sntp_sample.c",
      "-o",
      "gateway/physical_can/build/h3-isolated/sntp_sample.exe"
    ],
    "exit_code": 0
  },
  "p5-fresh": {
    "command": [
      "python",
      "gateway/mqtt/tests/run_p5_host_tests.py",
      "--network-irq",
      "--fresh-sntp"
    ],
    "exit_code": 1
  },
  "p5-legacy": {
    "command": [
      "python",
      "gateway/mqtt/tests/run_p5_host_tests.py"
    ],
    "exit_code": 0
  },
  "arm-isolated": {
    "command": [
      "python",
      "gateway/physical_can/build.py",
      "--irq",
      "--isolated",
      "--fresh-sntp"
    ],
    "exit_code": 0
  },
  "python-functional": {
    "command": [
      "python",
      "-m",
      "pytest",
      "cloud/ai/tests",
      "cloud/backend/tests",
      "gateway/physical_can/tests/test_h3_download.py",
      "gateway/physical_can/tests/test_h3_resume.py",
      "gateway/physical_can/tests/test_h3_observe.py",
      "-q"
    ],
    "exit_code": 0
  }
}