@@ -1,6 +1,7 @@
 /* CANopenNode 初始化使用 calloc；堆有固定上限，绝不越过预留主栈。 */
 #include <stddef.h>
 #include <errno.h>
+#include "probe_events.h"
 extern char _heap_start, _heap_end;
 
 /* newlib 堆只能增长到链接脚本保留区末尾；不足时返回 ENOMEM，不能挤占栈。 */
@@ -11,10 +12,12 @@
         current = &_heap_start;
     if (increment < 0 || increment > (&_heap_end - current))
     {
+        probe_heap_enomem();
         errno = ENOMEM;
         return (void *)-1;
     }
     char *previous = current;
     current += increment;
+    probe_heap_peak((uint32_t)(current - &_heap_start));
     return previous;
 }
