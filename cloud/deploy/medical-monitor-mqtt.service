[Unit]
Description=Medical monitor MQTT TLS broker
After=network.target

[Service]
Type=simple
User=mosquitto
Group=mosquitto
Environment=MONITOR_LOG_DIR=/opt/medical-monitor/logs/broker
ExecStart=/usr/bin/python3 /opt/medical-monitor/current/deploy/broker_logging.py
KillMode=mixed
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/medical-monitor/broker/data /opt/medical-monitor/logs/broker
UMask=0027

[Install]
WantedBy=multi-user.target
