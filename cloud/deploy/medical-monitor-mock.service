[Unit]
Description=Medical monitor synthetic MQTT publisher
After=network.target medical-monitor-mqtt.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/medical-monitor/current
ExecStart=/opt/medical-monitor/current/.venv/bin/python tools/mock_mqtt/main.py --config /opt/medical-monitor/mqtt-config/mock.json --control /opt/medical-monitor/mqtt-config/mock-control.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
